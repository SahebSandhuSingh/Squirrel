# Combined stack: both backends on one database. Copy to .env (never commit .env).
#   cp .env.example .env && docker compose up --build

# ── Database (shared server; each module writes only its own tables) ────────────────────────────
# Local (default): the postgis/postgis container from docker-compose.yml. Keep `local-db` here.
COMPOSE_PROFILES=local-db
# Supabase: remove the COMPOSE_PROFILES line above and set DATABASE_URL to the SESSION pooler
# (port 5432, user postgres.<project-ref>) or the direct connection. Not the transaction pooler
# (6543): the Run Module's migrator holds a session advisory lock. Put Supabase's CA certificate
# (Dashboard → Database → SSL Configuration) in deploy/certs/ and reference it from the URL:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/certs/prod-ca-2021.crt

# ── Run Module ──────────────────────────────────────────────────────────────────────────────────
# Redis for its queues and leaderboard cache. Default: the local redis container. Supabase has no
# Redis; for a hosted one (Upstash, Render Key Value) use its rediss:// URL.
# REDIS_URL=rediss://default:<password>@<host>:6379

# ONE secret for sign-in on both backends: the Exercise backend signs login tokens with it and the
# Run Module verifies them (run-module/docs/decisions/ADR-003). Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
# JWT_ISSUER=
# JWT_AUDIENCE=
# LOG_LEVEL=info
# Day boundary for the XP daily caps (run-module/docs/decisions/ADR-027).
# XP_TIMEZONE=Asia/Kolkata

# ── Both backends ───────────────────────────────────────────────────────────────────────────────
# The web app (Expo web build, e.g. on Vercel) runs on its own domain, so the browser needs each
# backend's permission to call it. Comma-separated origins; `*` matches one part of a host name
# (for Vercel preview URLs). Empty: no browser app on another domain. The phone app does not need it.
# CORS_ALLOWED_ORIGINS=https://squirrel-social.vercel.app,https://squirrel-social-*.vercel.app

# ── Exercise Mechanics ──────────────────────────────────────────────────────────────────────────
# Moderation review queue; unset = moderation endpoints answer 503.
# MODERATION_TOKEN=
# Accounts and profiles are stored in the database above (sessions stay in the exercise_data volume).
# Partner Hunt reads XP from the Run Module (run-api); outside compose, point it elsewhere:
# RUN_MODULE_URL=http://localhost:3000
# Sign-in is required on every per-user route. Set to 0 ONLY to try the browser coach (which has
# no sign-in yet) on your own machine; never in production.
# EXERCISE_REQUIRE_AUTH=0
# Public origin used in QR codes and invite links.
# SQUIRREL_PUBLIC_BASE_URL=https://squirrelsocial.app

# ── Host ports (change if something on this machine already uses them) ──────────────────────────
# EXERCISE_HOST_PORT=8000
# RUN_MODULE_HOST_PORT=3000
# POSTGRES_HOST_PORT=5435
# REDIS_HOST_PORT=6380
