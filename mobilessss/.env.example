# Leave everything empty for demo mode. On a phone, use your computer's LAN IP, not localhost.

# Exercise Mechanics backend (FastAPI). Also where accounts live: sign-up and sign-in use its
# /api/auth, and the same sign-in works on the Run Module.
EXPO_PUBLIC_EXERCISE_API_URL=
# Run Module backend (runs, territory, leaderboard). Needs the same JWT_SECRET as the Exercise backend.
EXPO_PUBLIC_API_URL=
# Optional: a separate account server. Defaults to EXPO_PUBLIC_EXERCISE_API_URL.
EXPO_PUBLIC_AUTH_URL=
