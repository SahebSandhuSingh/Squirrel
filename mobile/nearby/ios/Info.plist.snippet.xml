<!-- Merge into the app's Info.plist. -->
<key>NSBluetoothAlwaysUsageDescription</key>
<string>Squirrel Social uses Bluetooth to let you know when other Squirrel users are near you. Your identity is never broadcast.</string>
<key>UIBackgroundModes</key>
<array>
    <string>bluetooth-central</string>
    <string>bluetooth-peripheral</string>
</array>
<key>CFBundleURLTypes</key>
<array>
    <dict>
        <key>CFBundleURLSchemes</key>
        <array><string>squirrelsocial</string></array>
    </dict>
</array>
