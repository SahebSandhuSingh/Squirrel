# Run Module backend (leave empty for demo mode)
EXPO_PUBLIC_API_URL=
# Account service that issues RS256 bearer tokens (not built yet)
EXPO_PUBLIC_AUTH_URL=
# Exercise Mechanics backend (FastAPI; routes under /api). Leave empty to hide live exercise data
EXPO_PUBLIC_EXERCISE_API_URL=
# progress-service (../progress-service): XP, levels, Your Progress, Challenges, leaderboards. Empty = demo data
EXPO_PUBLIC_PROGRESS_API_URL=
# Campus social backend (users, zones, territories, crews, events, people, invites, meetups, badges).
# Defaults to EXPO_PUBLIC_API_URL. Empty + dev build = in-memory dev mock; empty + production = "not live yet" states.
EXPO_PUBLIC_CAMPUS_API_URL=
# Optional WebSocket for live updates (the backend's GET /v1/config can also announce it)
EXPO_PUBLIC_REALTIME_URL=
# Dev mock switch: 1 = force the campus dev mock (even in exported builds), 0 = never use it
EXPO_PUBLIC_DEV_MOCKS=
# Dev mock only: 'on' simulates a backend whose Date Mode safety gate is open
EXPO_PUBLIC_MOCK_DATE_MODE=
# Dev mock only: 0..1 chance that a write fails (exercise error states)
EXPO_PUBLIC_MOCK_FAIL_RATE=
# Never put server secrets or API keys in EXPO_PUBLIC_* — they ship inside the app.

# Per-endpoint opt-in for campus capabilities whose backend has shipped (see src/api/availability.ts).
# Comma-separated: sharedZones, heatmap, dateSuggestions, media, meetupRating, ambassador, ambassadorWaitlist, profileDetails, sharedWorkout
# Anything not listed rejects as "Not live yet" in every mode. Not a secret.
EXPO_PUBLIC_LIVE_ENDPOINTS=
