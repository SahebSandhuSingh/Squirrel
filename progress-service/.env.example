# PostgreSQL (production). SQLite works for quick local runs: sqlite:///./progress.db
DATABASE_URL=postgresql+psycopg://squirrel@127.0.0.1:5433/squirrel_progress
APP_ENV=development
# Auth: the same RS256 bearer tokens the app sends to the Run Module (JWT `sub` = user id).
JWT_ALGORITHMS=RS256
JWT_PUBLIC_KEY_FILE=./keys/auth_public.pem
# JWT_ISSUER=https://auth.squirrelsocial.in
# JWT_AUDIENCE=squirrel-social
# Development/test only: accept HS256 tokens signed with this secret (ignored when APP_ENV=production).
JWT_DEV_SECRET=dev-only-change-me
# Server-to-server ingest (Run Module, Exercise backend) and ops endpoints.
SERVICE_API_KEY=dev-service-key
# Level curve: linear:<xp per level> (the app uses 2000) or thresholds:0,1000,2500,...
LEVEL_CURVE=linear:2000
DEFAULT_TIMEZONE=Asia/Kolkata
# Late-arriving (offline) activity is accepted up to this many days old; challenges resolve after this grace.
OFFLINE_SYNC_WINDOW_DAYS=7
CHALLENGE_RESOLVE_GRACE_MINUTES=120
