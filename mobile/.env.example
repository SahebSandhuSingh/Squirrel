# Run Module backend (runs, XP, run leaderboard). Empty = runs stay on the phone
EXPO_PUBLIC_API_URL=
# Separate account service (optional). Leave empty: sign-in then uses the Exercise backend's /api/auth
# (email code → register, login, refresh), whose tokens Social, Run Module and progress-service accept.
EXPO_PUBLIC_AUTH_URL=
# Exercise Mechanics backend (FastAPI; routes under /api): accounts + form coach + /api/live counter
EXPO_PUBLIC_EXERCISE_API_URL=
# Social service (FastAPI; routes under /v1): profiles, waitlist + referrals, founding badges, crews +
# vouching, events + RSVP + check-in, feed + posts, XP / hostel leaderboards, daily stats,
# notifications + push tokens, photo uploads, head-to-head challenges. Empty = "not live yet" states.
EXPO_PUBLIC_SOCIAL_API_URL=
# Sign-up email domains, comma-separated (the backend enforces its own list too)
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAINS=iiserkol.ac.in
# progress-service (../progress-service): XP, levels, Your Progress, Challenges, leaderboards. Empty = "not connected"
EXPO_PUBLIC_PROGRESS_API_URL=
# Campus backend (zones, territories, map players, Date Mode, ratings…). Where the Social service
# implements a campus feature it answers instead. Defaults to EXPO_PUBLIC_API_URL. No mock backend.
EXPO_PUBLIC_CAMPUS_API_URL=
# Optional WebSocket for live updates (the backend's GET /v1/config can also announce it)
EXPO_PUBLIC_REALTIME_URL=
# Never put server secrets or API keys in EXPO_PUBLIC_* — they ship inside the app.

# Per-endpoint opt-in for campus capabilities whose backend has shipped (see src/api/availability.ts).
# Comma-separated: sharedZones, heatmap, dateSuggestions, media, meetupRating, ambassador, ambassadorWaitlist, profileDetails, sharedWorkout
# Anything not listed rejects as "Not live yet" in every mode. Not a secret.
EXPO_PUBLIC_LIVE_ENDPOINTS=
