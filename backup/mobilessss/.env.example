# Leave everything empty for demo mode. On a phone, use your computer's LAN IP, not localhost.

# Exercise Mechanics backend (FastAPI). Also where accounts live: sign-up and sign-in use its
# /api/auth, and the same sign-in works on the Run Module.
EXPO_PUBLIC_EXERCISE_API_URL=
# Run Module backend (runs, territory, leaderboard). Needs the same JWT_SECRET as the Exercise backend.
EXPO_PUBLIC_API_URL=
# Optional: a separate account server. Defaults to EXPO_PUBLIC_EXERCISE_API_URL.
EXPO_PUBLIC_AUTH_URL=
# Optional: a folder serving MediaPipe's vision_bundle.mjs, wasm/ and pose_landmarker_lite.task for
# live workouts. Empty: jsDelivr and Google's model storage (as the browser coach uses).
EXPO_PUBLIC_POSE_ASSETS_URL=
# Exercise Mechanics backend (FastAPI; routes under /api). Leave empty to hide live exercise data
EXPO_PUBLIC_EXERCISE_API_URL=
# Profile + Social service (../social-backend, routes under /v1). Defaults to EXPO_PUBLIC_API_URL
# when both sit behind one gateway. Local dev: http://localhost:8100 (Android emulator: http://10.0.2.2:8100)
EXPO_PUBLIC_SOCIAL_API_URL=
# Development only: 1 shows the pose debug overlay on the workout screen (FPS, model time,
# resolution, joints, framing, rep state) and logs [FRAME]/[POSE]/[EXERCISE] lines every 2 s.
# Never set it for a production or store build.
EXPO_PUBLIC_POSE_DEBUG=
